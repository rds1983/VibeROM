{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viberom.local/schema/area.schema.json",
  "title": "VibeROM area",
  "description": "One area file: metadata plus helps, mobiles, objects, rooms, resets, shops, specials and socials.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "name", "vnumRange"],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "legacyFile": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.are$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "credits": {
      "type": "string"
    },
    "vnumRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": {
          "$ref": "#/$defs/vnum"
        },
        "high": {
          "$ref": "#/$defs/vnum"
        }
      }
    },
    "security": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "builders": {
      "type": "string"
    },
    "helps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/help"
      }
    },
    "mobiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mobile"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/room"
      }
    },
    "resets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reset"
      }
    },
    "shops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shop"
      }
    },
    "specials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/special"
      }
    },
    "socials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/social"
      }
    }
  },
  "$defs": {
    "vnum": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "helpLevel": {
      "type": "integer",
      "minimum": -1,
      "maximum": 100
    },
    "actFlag": {
