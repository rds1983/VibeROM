{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viberom.local/schema/index.schema.json",
  "title": "VibeROM world index",
  "description": "Load order and provenance for the area JSON files in Data/areas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "source", "areas"],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "version", "releaseDate"],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "releaseDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*\\.json$"
      }
    }
  }
}
